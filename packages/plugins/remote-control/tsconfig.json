{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true
  },
  "include": ["*.ts", "*.tsx"]
}

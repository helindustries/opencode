{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-remote-control",
  "version": "2.0.32",
  "description": "Share opencode sessions with other machines through the ocmesh LAN registry",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./server": "./server.ts",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.ts",
    "server.ts",
    "tui.tsx",
    "mesh.ts",
    "endpoint.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:"
  }
}
